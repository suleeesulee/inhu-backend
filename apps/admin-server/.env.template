# 타임존
TZ=Asia/Seoul

# postgreSQL 설정
DATABASE_URL=

# Cors 목록. 띄워쓰기로 구분
CORS_ORIGIN=

# 쿠키 옵션에서 개발용과 운영용, 테스트용을 구분하기 위해 사용
# `getMode` 메서드 확인
# 개발용: development -> local 에서 개발할 때
# 운영용: production -> 실제 서비스 환경
# 테스트용: test
NODE_ENV=

# jwt options
JWT_SECRET=
JWT_EXPIRES_IN=1h

# AWS S3 설정
AWS_REGION=
AWS_S3_BUCKET_NAME=
AWS_S3_PRIVATE_BUCKET_NAME=
AWS_S3_FILE_HOST=

# 코드에서 직접 사용하지 않고, S3Client 라이브러리에서 사용함
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# admin-server 포트 번호
ADMIN_SERVER_PORT=

# Discord Webhook URL
DISCORD_WEBHOOK_URL=
DISCORD_ERROR_WEBHOOK_URL=

# OpenAI API
OPENAI_API_KEY=

# Puppeteer 설정
PUPPETEER_CUSTOM_EXECUTABLE_PATH=
PUPPETEER_SELECTOR_TIMEOUT=

# 네이버 플레이스 크롤링 관련 설정
NAVER_MENU_BATCH_SIZE=

# 메뉴 DOM 형식별 셀렉터 프로필 (프로필 하나당 JSON 환경변수 하나)
# NAVER_MENU_PCMAP_PROFILE_B='{"liSelector":"B1","nameSelector":"B2","priceSelector":"B3","contentSelector":"B4","imageSelector":"B5"}'
# NAVER_MENU_BOOKING_PROFILE_B='{"liSelector":"B1","nameSelector":"B2","priceSelector":"B3","contentSelector":"B4","imageSelector":"B5"}'

# pm2 process 구분용
SERVICE_NAME=

# swagger stats 설정
TIME_LINE_BUCKET_DURATION=

# GA4 세팅
GA4_PROPERTY_ID=
# key파일 json의 절대경로
GOOGLE_APPLICATION_CREDENTIALS=

# 암호화 관련 설정
CRYPTO_ENCRYPTION_KEY=
CRYPTO_HMAC_KEY=

# NFC AES-128 키 (16바이트 hexadecimal)
NFC_MASTER_KEY=

# Push Notification 공통 설정
PUSH_NOTIFICATION_APP_BUNDLE_ID=

# Push Notification - iOS (APNs) 설정
PUSH_NOTIFICATION_APN_TEAM_ID=
PUSH_NOTIFICATION_APN_KEY_ID=
PUSH_NOTIFICATION_APN_KEY=

# Push Notification - Android (FCM) 설정
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 후 파일명 입력
FCM_KEY_FILE=
