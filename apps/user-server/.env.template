# 타임존
TZ=Asia/Seoul

# postgreSQL 설정
DATABASE_URL=

# 카카오 로그인 설정
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=

# jwt 비밀 키
JWT_SECRET=
# 앱 리프레시 토큰 만료 기간
APP_REFRESH_TOKEN_AGE_DATES=
# 웹 리프레시 토큰 만료 기간
WEB_REFRESH_TOKEN_AGE_DATES=
# 앱 액세스 토큰 만료 기간
ACCESS_TOKEN_AGE_MINUTES=

# redirect 시킬 main 페이지 URL
MAIN_PAGE_URL=

# Cors 목록. 띄워쓰기로 구분
CORS_ORIGIN=

# 쿠키 옵션에서 개발용과 운영용, 테스트용을 구분하기 위해 사용
# `getMode` 메서드 확인
# 개발용: development -> local 에서 개발할 때
# 운영용: production -> 실제 서비스 환경
# 테스트용: test
NODE_ENV=

# AWS S3 설정
AWS_REGION=
AWS_S3_BUCKET_NAME=
AWS_S3_FILE_HOST=

# 코드에서 직접 사용하지 않고, S3Client 라이브러리에서 사용함
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Redis 설정
REDIS_HOST=
REDIS_PORT=
REDLOCK_URIS=

# Apple 로그인 설정
APPLE_TEAM_ID=
APPLE_SERVICE_CLIENT_ID=
APPLE_APP_CLIENT_ID=
APPLE_REDIRECT_URI=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Discord Webhook URL
DISCORD_WEBHOOK_URL=
DISCORD_ERROR_WEBHOOK_URL=

# pm2 process 구분용
SERVICE_NAME=

# swagger stats 설정
TIME_LINE_BUCKET_DURATION=

# 룰렛 관련 설정
TARGET_PLACE_IDX_LIST=
MULTIPLIER=

# 암호화 관련 설정
CRYPTO_ENCRYPTION_KEY=
CRYPTO_HMAC_KEY=

# Push Notification 공통 설정
PUSH_NOTIFICATION_APP_BUNDLE_ID=

# Push Notification - iOS (APNs) 설정
PUSH_NOTIFICATION_APN_TEAM_ID=
PUSH_NOTIFICATION_APN_KEY_ID=
PUSH_NOTIFICATION_APN_KEY=

# Push Notification - Android (FCM) 설정
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 후 파일명 입력
FCM_KEY_FILE=

# NFC AES-128 키 (16바이트 hexadecimal)
NFC_MASTER_KEY=
