generator client {
    provider = "prisma-client-js"
    output   = "../generated/log"
}

datasource db {
    provider = "postgresql"
    url      = env("LOG_DATABASE_URL")
}

model EventTypes {
    idx        Int          @id
    name       String       @db.VarChar
    factEvents FactEvents[]

    @@map("event_types")
}

model FactEvents {
    id                   String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
    typeIdx              Int                   @map("type_idx")
    userIdx              Int?                  @map("user_idx")
    eventTime            DateTime              @map("event_time") @db.Timestamptz
    createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz
    deviceType           Int                   @map("device_type")
    platform             Int
    eventType            EventTypes            @relation(fields: [typeIdx], references: [idx])
    factEventProperties  FactEventProperties[]

    @@map("fact_events")
}

model FactEventProperties {
    eventId String     @map("event_id") @db.Uuid
    key     String     @db.VarChar
    value   String     @db.VarChar
    event   FactEvents @relation(fields: [eventId], references: [id])

    @@map("fact_event_properties")
}

model DimUsers {
    id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
    idx       Int
    signupAt  DateTime @map("signup_at") @db.Timestamptz
    updatedAt DateTime @map("updated_at") @db.Timestamptz
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
    provider  String?  @db.VarChar
    platform  String   @db.VarChar

    @@map("dim_users")
}
