generator client {
    provider = "prisma-client-js"
    output   = "../generated/log"
}

datasource db {
    provider = "postgresql"
    url      = env("LOG_DATABASE_URL")
}

model EventTypes {
    idx        Int          @id
    name       String       @db.VarChar
    factEvents FactEvents[]

    @@map("event_types")
}

model FactEvents {
    id                  String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
    typeIdx             Int                   @map("type_idx")
    userIdx             Int?                  @map("user_idx")
    eventTime           DateTime              @map("event_time") @db.Timestamptz
    createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz
    deviceType          Int                   @map("device_type")
    platform            Int
    eventType           EventTypes            @relation(fields: [typeIdx], references: [idx])
    factEventProperties FactEventProperties[]

    @@index([typeIdx], map: "index_fact_type_idx")
    @@index([eventTime], map: "index_fact_event_time")
    @@index([userIdx], map: "index_fact_user_idx")
    @@map("fact_events")
}

model FactEventProperties {
    id            String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
    eventId       String     @map("event_id") @db.Uuid
    propertyKey   String     @map("property_key") @db.VarChar
    propertyValue String     @map("property_value") @db.VarChar
    event         FactEvents @relation(fields: [eventId], references: [id])

    @@unique([eventId, propertyKey], map: "fact_event_properties_event_id_key_uk")
    @@map("fact_event_properties")
}

model DimUsers {
    id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
    idx              Int
    signupAt         DateTime  @map("signup_at") @db.Timestamptz
    nickname         String    @db.VarChar
    platform         String    @db.VarChar
    profileImagePath String?   @map("profile_image_path") @db.VarChar
    deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
    createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
    validFrom        DateTime  @map("valid_from") @db.Timestamptz

    @@unique([idx, validFrom], map: "uq_dim_users_idx_valid_from")
    @@index([validFrom], map: "index_dim_users_valid_from_index")
    @@map("dim_users")
}

model DimUserProviders {
    id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
    idx       Int
    provider  String   @db.VarChar
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
    validFrom DateTime @map("valid_from") @db.Timestamptz

    @@unique([idx, validFrom], map: "uq_dim_user_providers_idx_valid_from")
    @@index([idx, validFrom], map: "index_dim_user_providers_idx_valid_from")
    @@map("dim_user_providers")
}
