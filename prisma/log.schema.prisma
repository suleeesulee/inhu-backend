generator client {
  provider = "prisma-client-js"
  output   = "../generated/log"
}

datasource db {
  provider = "postgresql"
  url      = env("LOG_DATABASE_URL")
}

model DimBreakTimes {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  idx       Int
  placeIdx  Int       @map("place_idx")
  startAt   DateTime  @map("start_at") @db.Time(6)
  endAt     DateTime  @map("end_at") @db.Time(6)
  day       Int       @db.SmallInt
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  validFrom DateTime  @map("valid_from") @db.Timestamptz

  @@unique([idx, validFrom], map: "uq_dim_break_times_idx_valid_from")
  @@index([validFrom], map: "index_dim_break_times_valid_from")
  @@map("dim_break_times")
}

