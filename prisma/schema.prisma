generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bookmark {
  userIdx   Int      @map("user_idx")
  placeIdx  Int      @map("place_idx")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  place     Place    @relation(fields: [placeIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_place_tb_to_bookmark_tb")
  user      User     @relation(fields: [userIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_tb_to_bookmark_tb")

  @@id([userIdx, placeIdx])
  @@map("bookmark_tb")
}

model Keyword {
  idx                      Int                    @id
  content                  String                 @unique @db.VarChar
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt                DateTime?              @map("deleted_at") @db.Timestamptz(6)
  placeKeywordCountList    PlaceKeywordCount[]
  reviewKeywordMappingList ReviewKeywordMapping[]

  @@map("keyword_tb")
}

model PlaceImage {
  idx       Int       @id @default(autoincrement())
  placeIdx  Int       @map("place_idx")
  path      String    @map("image_path") @db.VarChar
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  place     Place     @relation(fields: [placeIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_place_tb_to_place_image_tb")

  @@map("place_image_tb")
}

model Place {
  idx                          Int                        @id @default(autoincrement())
  name                         String                     @db.VarChar
  tel                          String?                    @db.VarChar
  reviewCount                  Int                        @default(0) @map("review_count")
  bookmarkCount                Int                        @default(0) @map("bookmark_count")
  roadAddressIdx               Int                        @map("road_address_idx")
  isClosedOnHoliday            Boolean?                   @map("is_closed_on_holiday")
  priority                     Int?                       @db.SmallInt
  createdAt                    DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt                    DateTime?                  @map("deleted_at") @db.Timestamptz(6)
  permanentlyClosedAt          DateTime?                  @map("permanently_closed_at") @db.Timestamptz(6)
  activatedAt                  DateTime?                  @map("activated_at") @db.Timestamptz(6)
  blogReview                   BlogReview[]
  bookmarkList                 Bookmark[]
  breakTimeList                BreakTime[]
  closedDayList                ClosedDay[]
  magazinePlaceList            MagazinePlace[]
  menuList                     Menu[]
  nfcList                      Nfc[]
  operatingHourList            OperatingHour[]
  pickedPlace                  PickedPlace?
  placeFreeTagMappingList      PlaceFreeTagMapping[]
  placeImageList               PlaceImage[]
  placeKeywordCountList        PlaceKeywordCount[]
  placeMainCategoryMappingList PlaceMainCategoryMapping[]
  placeMoodCategoryMappingList PlaceMoodCategoryMapping[]
  placeOwnerList               PlaceOwner[]
  placeSearchTagMappingList    PlaceSearchTagMapping[]
  roadAddress                  RoadAddress                @relation(fields: [roadAddressIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_road_address_tb_to_place_tb")
  placeTypeMappingList         PlaceTypeMapping[]
  reviewList                   Review[]
  weeklyClosedDayList          WeeklyClosedDay[]

  @@map("place_tb")
}

model RoadAddress {
  idx           Int     @id @default(autoincrement())
  addressName   String  @map("address_name") @db.VarChar
  detailAddress String? @map("detail_address") @db.VarChar
  addressX      Decimal @map("address_x") @db.Decimal
  addressY      Decimal @map("address_y") @db.Decimal
  place         Place[]

  @@map("road_address_tb")
}

model PickedPlace {
  idx       Int       @id @default(autoincrement())
  placeIdx  Int       @unique @map("place_idx")
  title     String    @db.VarChar
  content   String    @db.VarChar
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  place     Place     @relation(fields: [placeIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_place_tb_to_picked_place_tb")

  @@map("picked_place_tb")
}

model OperatingHour {
  idx      Int      @id @default(autoincrement())
  placeIdx Int      @map("place_idx")
  startAt  DateTime @map("start_at") @db.Time(6)
  endAt    DateTime @map("end_at") @db.Time(6)
  day      Int      @db.SmallInt
  place    Place    @relation(fields: [placeIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_place_tb_to_operating_hour_tb")

  @@map("operating_hour_tb")
}

model BreakTime {
  idx      Int      @id @default(autoincrement())
  placeIdx Int      @map("place_idx")
  startAt  DateTime @map("start_at") @db.Time(6)
  endAt    DateTime @map("end_at") @db.Time(6)
  day      Int      @db.SmallInt
  place    Place    @relation(fields: [placeIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_place_tb_to_break_time_tb")

  @@map("break_time_tb")
}

model PlaceKeywordCount {
  placeIdx   Int     @map("place_idx")
  keywordIdx Int     @map("keyword_idx")
  count      Int     @default(0)
  keyword    Keyword @relation(fields: [keywordIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_keyword_tb_to_place_keyword_count_tb")
  place      Place   @relation(fields: [placeIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_place_tb_to_place_keyword_count_tb")

  @@id([placeIdx, keywordIdx])
  @@map("place_keyword_count_tb")
}

model PlaceTypeMapping {
  placeTypeIdx Int       @map("place_type_idx")
  placeIdx     Int       @map("place_idx")
  place        Place     @relation(fields: [placeIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_place_tb_to_place_type_mapping_tb")
  placeType    PlaceType @relation(fields: [placeTypeIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_place_type_tb_to_place_type_mapping_tb")

  @@id([placeTypeIdx, placeIdx])
  @@map("place_type_mapping_tb")
}

model PlaceType {
  idx                          Int                        @id
  content                      String                     @unique @db.VarChar
  createdAt                    DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt                    DateTime?                  @map("deleted_at") @db.Timestamptz(6)
  placeTypeMagazineMappingList PlaceTypeMagazineMapping[]
  placeTypeMappingList         PlaceTypeMapping[]

  @@map("place_type_tb")
}

model Menu {
  idx        Int          @id @default(autoincrement())
  placeIdx   Int          @map("place_idx")
  name       String       @db.VarChar
  content    String?      @db.VarChar
  price      Int?
  imagePath  String?      @map("image_path") @db.VarChar
  isFlexible Boolean      @default(false) @map("is_flexible")
  sortOrder  Int          @map("sort_order") @db.SmallInt
  isMain     Boolean      @default(true) @map("is_main")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt  DateTime?    @map("deleted_at") @db.Timestamptz(6)
  reviewList MenuReview[]
  place      Place        @relation(fields: [placeIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_place_tb_to_menu_tb")

  @@map("menu_tb")
}

model ReviewImage {
  idx       Int    @id @default(autoincrement())
  reviewIdx Int    @map("review_idx")
  path      String @map("image_path") @db.VarChar
  review    Review @relation(fields: [reviewIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_review_tb_to_review_image_tb")

  @@map("review_image_tb")
}

model ReviewKeywordMapping {
  reviewIdx  Int     @map("review_idx")
  keywordIdx Int     @map("keyword_idx")
  keyword    Keyword @relation(fields: [keywordIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_keyword_tb_to_review_keyword_mapping_tb")
  review     Review  @relation(fields: [reviewIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_review_tb_to_review_keyword_mapping_tb")

  @@id([reviewIdx, keywordIdx])
  @@map("review_keyword_mapping_tb")
}

model Review {
  idx                      Int                    @id @default(autoincrement())
  userIdx                  Int                    @map("user_idx")
  placeIdx                 Int                    @map("place_idx")
  content                  String                 @db.VarChar
  isMenuChecked            Boolean                @default(false) @map("is_menu_checked")
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt                DateTime?              @map("deleted_at") @db.Timestamptz(6)
  menuReviewList           MenuReview[]
  reviewImageList          ReviewImage[]
  reviewKeywordMappingList ReviewKeywordMapping[]
  place                    Place                  @relation(fields: [placeIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_place_tb_to_review_tb")
  user                     User                   @relation(fields: [userIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_tb_to_review_tb")

  @@map("review_tb")
}

model Service1Result {
  idx         Int      @id @default(autoincrement())
  userIdx     Int      @map("user_idx")
  service1Idx Int      @map("service1_idx")
  content     String?  @db.VarChar
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  service1    Service1 @relation(fields: [service1Idx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_service1_tb_to_service1_result_tb")
  user        User     @relation(fields: [userIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_tb_to_service1_result_tb")

  @@map("service1_result_tb")
}

model Service1 {
  idx                Int              @id @default(autoincrement())
  content            String?          @db.VarChar
  service1ResultList Service1Result[]

  @@map("service1_tb")
}

model Service2Result {
  idx         Int      @id @default(autoincrement())
  userIdx     Int      @map("user_idx")
  service2Idx Int      @map("service2_idx")
  content     String?  @db.VarChar
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  service2    Service2 @relation(fields: [service2Idx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_service2_tb_to_service2_result_tb")
  user        User     @relation(fields: [userIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_tb_to_service2_result_tb")

  @@map("service2_result_tb")
}

model Service2 {
  idx                Int              @id @default(autoincrement())
  content            String?          @db.VarChar
  service2ResultList Service2Result[]

  @@map("service2_tb")
}

model UserProvider {
  idx   Int    @id
  name  String @db.VarChar
  snsId String @map("sns_id") @db.VarChar
  user  User   @relation(fields: [idx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_tb_to_user_provider_tb")

  @@map("user_provider_tb")
}

model User {
  idx                       Int                     @id @default(autoincrement())
  nickname                  String                  @db.VarChar
  profileImagePath          String?                 @map("profile_image_path") @db.VarChar
  platform                  String                  @default("unknown") @db.VarChar
  createdAt                 DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt                 DateTime?               @map("deleted_at") @db.Timestamptz(6)
  adminAccount              AdminAccount?
  bookmarkList              Bookmark[]
  cafeteriaBookmark         CafeteriaBookmark[]
  installationList          Installation[]
  leagueSeasonResultList    LeagueSeasonResult[]
  magazineLike              MagazineLike[]
  magazine                  Magazine[]
  placeOwnerList            PlaceOwner[]
  placeVisitList            PlaceVisit[]
  reviewList                Review[]
  service1ResultList        Service1Result[]
  service2ResultList        Service2Result[]
  userEmail                 UserEmail?
  userProvider              UserProvider?
  withdrawServiceResultList WithdrawServiceResult[]

  @@map("user_tb")
}

model AdminAccount {
  idx       Int      @id
  id        String   @db.VarChar
  pw        String   @db.VarChar
  role      String   @default("ADMIN") @db.VarChar
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [idx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_tb_to_admin_tb")

  @@map("admin_account_tb")
}

model WithdrawServiceResult {
  idx                Int             @id @default(autoincrement())
  userIdx            Int             @map("user_idx")
  withdrawServiceIdx Int             @map("withdraw_service_idx")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  user               User            @relation(fields: [userIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_tb_to_withdraw_service_result_tb")
  withdrawService    WithdrawService @relation(fields: [withdrawServiceIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_withdraw_service_tb_to_withdraw_service_result_tb")

  @@map("withdraw_service_result_tb")
}

model WithdrawService {
  idx                       Int                     @id @default(autoincrement())
  content                   String?                 @db.VarChar
  withdrawServiceResultList WithdrawServiceResult[]

  @@map("withdraw_service_tb")
}

model ClosedDay {
  idx      Int   @id @default(autoincrement())
  placeIdx Int   @map("place_idx")
  day      Int   @db.SmallInt
  week     Int   @db.SmallInt
  place    Place @relation(fields: [placeIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_place_tb_to_closed_day_tb")

  @@map("closed_day_tb")
}

model WeeklyClosedDay {
  idx        Int      @id @default(autoincrement())
  placeIdx   Int      @map("place_idx")
  closedDate DateTime @map("closed_date") @db.Date
  type       Int      @default(0) @db.SmallInt
  place      Place    @relation(fields: [placeIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_place_tb_to_weekly_closed_day_tb")

  @@map("weekly_closed_day_tb")
}

model PlaceOwner {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  placeIdx  Int       @map("place_idx")
  userIdx   Int       @map("user_idx")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  place     Place     @relation(fields: [placeIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_place_tb_to_place_owner_tb")
  user      User      @relation(fields: [userIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_tb_to_place_owner_tb")

  @@map("place_owner_tb")
}

model BlogReview {
  idx                    Int       @id @default(autoincrement())
  placeIdx               Int       @map("place_idx")
  blogName               String    @map("blog_name") @db.VarChar
  title                  String    @db.VarChar
  description            String?   @db.VarChar
  contents               String?   @db.VarChar
  authorName             String    @map("author_name") @db.VarChar
  authorProfileImagePath String?   @map("author_profile_image_path") @db.VarChar
  thumbnailImagePath     String?   @map("thumbnail_image_path") @db.VarChar
  url                    String    @db.VarChar
  blogType               Int       @default(0) @map("blog_type") @db.SmallInt
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  uploadedAt             DateTime  @map("uploaded_at") @db.Timestamptz(6)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)
  place                  Place     @relation(fields: [placeIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_place_tb_to_blog_review_tb")

  @@map("blog_review_tb")
}

model MenuReview {
  menuIdx   Int    @map("menu_idx")
  reviewIdx Int    @map("review_idx")
  menu      Menu   @relation(fields: [menuIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_menu_tb_to_menu_review_tb")
  review    Review @relation(fields: [reviewIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_review_tb_to_menu_review_tb")

  @@id([menuIdx, reviewIdx])
  @@map("menu_review_tb")
}

model MagazinePlace {
  magazineIdx Int      @map("magazine_idx")
  placeIdx    Int      @map("place_idx")
  magazine    Magazine @relation(fields: [magazineIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_magazine_tb_to_magazine_place_tb")
  place       Place    @relation(fields: [placeIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_place_tb_to_magazine_place_tb")

  @@id([magazineIdx, placeIdx])
  @@map("magazine_place_tb")
}

model Magazine {
  idx                             Int                           @id @default(autoincrement())
  authorIdx                       Int                           @map("author_idx")
  title                           String                        @db.VarChar
  description                     String?                       @db.VarChar
  content                         String                        @db.VarChar
  thumbnailImagePath              String?                       @map("thumbnail_image_path") @db.VarChar
  isTitleVisible                  Boolean                       @default(false) @map("is_title_visible")
  likeCount                       Int                           @default(0) @map("like_count")
  viewCount                       Int                           @default(0) @map("view_count")
  createdAt                       DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  activatedAt                     DateTime?                     @map("activated_at") @db.Timestamptz(6)
  deletedAt                       DateTime?                     @map("deleted_at") @db.Timestamptz(6)
  magazineLike                    MagazineLike[]
  magazineMainCategoryMappingList MagazineMainCategoryMapping[]
  magazineMoodCategoryMappingList MagazineMoodCategoryMapping[]
  placeList                       MagazinePlace[]
  userTb                          User                          @relation(fields: [authorIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_tb_to_magazine_tb")
  pinnedMagazine                  PinnedMagazine?
  placeTypeMagazineMappingList    PlaceTypeMagazineMapping[]

  @@map("magazine_tb")
}

model MagazineLike {
  magazineIdx Int      @map("magazine_idx")
  userIdx     Int      @map("user_idx")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  magazine    Magazine @relation(fields: [magazineIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_magazine_tb_to_magazine_like_tb")
  user        User     @relation(fields: [userIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_tb_to_magazine_like_tb")

  @@id([magazineIdx, userIdx])
  @@map("magazine_like_tb")
}

model PinnedMagazine {
  idx       Int      @id
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  magazine  Magazine @relation(fields: [idx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_magazine_tb_to_pinned_magazine_tb")

  @@map("pinned_magazine_tb")
}

model PlaceMainCategoryMapping {
  mainCategoryIdx Int          @map("main_category_idx")
  placeIdx        Int          @map("place_idx")
  mainCategory    MainCategory @relation(fields: [mainCategoryIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_main_category_tb_to_place_main_category_mapping_tb")
  place           Place        @relation(fields: [placeIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_place_tb_to_place_main_category_mapping_tb")

  @@id([mainCategoryIdx, placeIdx])
  @@map("place_main_category_mapping_tb")
}

model PlaceMoodCategoryMapping {
  moodCategoryIdx Int          @map("mood_category_idx")
  placeIdx        Int          @map("place_idx")
  moodCategory    MoodCategory @relation(fields: [moodCategoryIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_mood_category_tb_to_place_mood_category_mapping_tb")
  place           Place        @relation(fields: [placeIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_place_tb_to_place_mood_category_mapping_tb")

  @@id([moodCategoryIdx, placeIdx])
  @@map("place_mood_category_mapping_tb")
}

model MainCategory {
  idx                             Int                           @id
  content                         String                        @db.VarChar
  createdAt                       DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt                       DateTime?                     @map("deleted_at") @db.Timestamptz(6)
  magazineMainCategoryMappingList MagazineMainCategoryMapping[]
  placeMainCategoryMappingList    PlaceMainCategoryMapping[]

  @@map("main_category_tb")
}

model MoodCategory {
  idx                             Int                           @id
  content                         String                        @db.VarChar
  createdAt                       DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt                       DateTime?                     @map("deleted_at") @db.Timestamptz(6)
  magazineMoodCategoryMappingList MagazineMoodCategoryMapping[]
  placeMoodCategoryMappingList    PlaceMoodCategoryMapping[]

  @@map("mood_category_tb")
}

model MagazineMainCategoryMapping {
  mainCategoryIdx Int          @map("main_category_idx")
  magazineIdx     Int          @map("magazine_idx")
  magazine        Magazine     @relation(fields: [magazineIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_magazine_tb_to_magazine_main_category_mapping_tb")
  mainCategory    MainCategory @relation(fields: [mainCategoryIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_main_category_tb_to_magazine_main_category_mapping_tb")

  @@id([mainCategoryIdx, magazineIdx])
  @@map("magazine_main_category_mapping_tb")
}

model MagazineMoodCategoryMapping {
  moodCategoryIdx Int          @map("mood_category_idx")
  magazineIdx     Int          @map("magazine_idx")
  magazine        Magazine     @relation(fields: [magazineIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_magazine_tb_to_magazine_mood_category_mapping_tb")
  moodCategory    MoodCategory @relation(fields: [moodCategoryIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_mood_category_tb_to_magazine_mood_category_mapping_tb")

  @@id([moodCategoryIdx, magazineIdx])
  @@map("magazine_mood_category_mapping_tb")
}

model PlaceTypeMagazineMapping {
  placeTypeIdx Int       @map("place_type_idx")
  magazineIdx  Int       @map("magazine_idx")
  magazine     Magazine  @relation(fields: [magazineIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_magazine_tb_to_place_type_magazine_mapping_tb")
  placeType    PlaceType @relation(fields: [placeTypeIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_place_type_tb_to_place_type_magazine_mapping_tb")

  @@id([placeTypeIdx, magazineIdx])
  @@map("place_type_magazine_mapping_tb")
}

model FreeTag {
  idx                     Int                   @id @default(autoincrement())
  content                 String                @db.VarChar
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt               DateTime?             @map("deleted_at") @db.Timestamptz(6)
  placeFreeTagMappingList PlaceFreeTagMapping[]

  @@map("free_tag_tb")
}

model PlaceFreeTagMapping {
  freeTagIdx Int     @map("free_tag_idx")
  placeIdx   Int     @map("place_idx")
  freeTag    FreeTag @relation(fields: [freeTagIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_free_tag_tb_to_place_free_tag_mapping_tb")
  place      Place   @relation(fields: [placeIdx], references: [idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_place_tb_to_place_free_tag_mapping_tb")

  @@id([freeTagIdx, placeIdx])
  @@map("place_free_tag_mapping_tb")
}

model SearchTag {
  idx                       Int                     @id @default(autoincrement())
  content                   String                  @db.VarChar
  createdAt                 DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt                 DateTime?               @map("deleted_at") @db.Timestamptz(6)
  placeSearchTagMappingList PlaceSearchTagMapping[]

  @@map("search_tag_tb")
}

model PlaceSearchTagMapping {
